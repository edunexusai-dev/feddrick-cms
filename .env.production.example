# ---------------------------------------------------------------------------
# Feddrick CMS (Strapi) — production environment template
# All values are placeholders. Replace <…> tokens before deployment.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=1337
# Trust X-Forwarded-* headers from nginx reverse proxy
PROXY_ENABLED=true

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=<key1>,<key2>,<key3>,<key4>
API_TOKEN_SALT=<random>
ADMIN_JWT_SECRET=<random>
JWT_SECRET=<random>
TRANSFER_TOKEN_SALT=<random>
ENCRYPTION_KEY=<random>

# PostgreSQL on RDS (dedicated feddrick_cms database)
DATABASE_CLIENT=postgres
DATABASE_HOST=edunexus-postgres.cc7y0cms2un6.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=feddrick_cms
DATABASE_USERNAME=<DB_USER>
DATABASE_PASSWORD=<DB_PASSWORD>
DATABASE_SSL=true

STRAPI_TELEMETRY_DISABLED=true
FLAG_NPS=false
FLAG_PROMOTE_EE=false
